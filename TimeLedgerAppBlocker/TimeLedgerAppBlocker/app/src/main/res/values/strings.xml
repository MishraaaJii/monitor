    <!-- Permissions screen -->
    <string name="permissions_title">Permissions</string>
    <string name="permissions_intro">Time Ledger needs two permissions to track app usage and enforce limits. Android requires you to grant these yourself in Settings \u2014 no app can turn these on for itself.</string>

    <string name="perm_usage_title">Usage Access</string>
    <string name="perm_usage_desc">Lets Time Ledger read how long each app has been used today, so it can show totals and know when a limit is reached.</string>
    <string name="perm_usage_granted">Granted</string>
    <string name="perm_usage_not_granted">Not granted</string>
    <string name="perm_usage_button">Open Usage Access settings</string>

    <string name="perm_accessibility_title">Accessibility Service</string>
    <string name="perm_accessibility_desc">Lets Time Ledger notice the instant a limited app opens and send you back to the Home screen if today\'s limit for it has already been reached.</string>
    <string name="perm_accessibility_granted">Enabled</string>
    <string name="perm_accessibility_not_granted">Not enabled</string>
    <string name="perm_accessibility_button">Open Accessibility settings</string>

    <string name="perm_battery_title">Background reliability (optional)</string>
    <string name="perm_battery_desc">Some phones aggressively kill background services to save battery, which can stop blocking from working. Exempting Time Ledger from battery optimization keeps it reliable.</string>
    <string name="perm_battery_granted">Exempted</string>
    <string name="perm_battery_not_granted">Not exempted</string>
    <string name="perm_battery_button">Request exemption</string>

    <string name="permissions_done">Done</string>

    <string name="accessibility_service_description">Watches which app is currently in the foreground so Time Ledger can send you home when a daily app limit you set has been reached. Does not read screen content.</string>

    <string name="limit_reached_toast">Daily limit reached for %1$s</string>
</resources>
